# 公開カードのみなら任意
GITHUB_USERNAME=
GITHUB_TOKEN=

# 非公開リポジトリとの連携時に設定
# openssl rand -base64 32 で生成し、秘密値は公開しないこと
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXTAUTH_URL=http://localhost:3000

# 42 カード（/api/42.svg）を使う場合に設定
# https://profile.intra.42.fr/oauth/applications で発行した UID / SECRET
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
# 表示を許可する 42 ログイン（カンマ区切り。先頭が既定）
FORTYTWO_LOGIN=
